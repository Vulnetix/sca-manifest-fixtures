opam-version: "2.0"
name: "myapp"
version: "0.1.0"
synopsis: "A sample OCaml application"
maintainer: "dev@example.com"
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0" & build}
  "lwt" {>= "5.7"}
  "cohttp-lwt-unix" {>= "6.0"}
  "yojson" {>= "2.1"}
]
