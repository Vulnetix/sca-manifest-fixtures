cabal-version:      3.0
name:               myapp
version:            0.1.0.0
synopsis:           Test project for haskell-cabal
license:            MIT
author:             test
build-type:         Simple

executable myapp
    main-is:          Main.hs
    build-depends:    base >=4.17 && <5,
                      aeson >=2.2,
                      text >=2.1,
                      conduit >=1.3,
                      http-client >=0.7,
                      optparse-applicative >=0.18
    default-language: Haskell2010
    ghc-options:      -O2 -Wall
